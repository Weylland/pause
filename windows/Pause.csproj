<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Pause</AssemblyName>
    <Product>Fil des jours</Product>
    <Version>1.6.1</Version>
    <ApplicationIcon>Pause.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="../design/fonts/*.ttf" Link="Fonts/%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="Pause.Tests" />
    <EmbeddedResource Include="../nutrition/ciqual.tsv" LogicalName="Pause.ciqual.tsv" />
    <PackageReference Include="QRCoder" Version="1.7.0" />
  </ItemGroup>
</Project>
